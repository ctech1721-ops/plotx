# Backend environment variables for Plot X Realty
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:YOUR_DB_PORT/YOUR_DB_NAME?sslmode=require
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-your-admin-password
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Public user OTP providers
MSG91_AUTHKEY=your-msg91-authkey
MSG91_OTP_TEMPLATE_ID=your-msg91-sms-template-id
MSG91_OTP_VAR=VAR1
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=Plot X Realty <login@yourdomain.com>
